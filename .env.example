# ── Flask / App ───────────────────────────────────────────────────────────────
# Path to the SQLite database file
FLIPPHONE_DB=flipphone.db

# ML prediction service URL
PREDICTION_API_URL=http://localhost:8000

# ── Security ──────────────────────────────────────────────────────────────────
# Allowed CORS origin — set to your domain in production, leave * for local dev
FLIPPHONE_ALLOWED_ORIGIN=*

# Rate limit for the public /api/predict endpoint (Flask-Limiter syntax)
FLIPPHONE_PREDICT_RATE=30 per minute

# ── Logging ───────────────────────────────────────────────────────────────────
FLIPPHONE_LOG_DIR=logs
FLIPPHONE_LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
